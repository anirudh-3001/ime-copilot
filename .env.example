# Copy to .env (cp .env.example .env). Lines starting with # are comments.

# ================================================================ SIMPLE LOCAL SETUP (Mac + Ollama)
# Everything runs on this computer; nothing is sent to the internet.
IME_PROVIDER=local
IME_MODEL_ANSWER=gemma4:26b-a4b            # the model that writes answers (try medgemma later)
IME_MODEL_EMBED=qwen3-embedding:0.6b       # the model used for search
IME_LOCAL_BASE_URL=http://localhost:11434/v1
IME_LOCAL_NUM_CTX=16384                    # context window for answers; lower to 8192 if memory is tight
IME_EXTRACTOR=rules                        # keep 'rules': don't run the big model over all 2,000 pages
IME_OCR=auto                               # PDF text first, Tesseract for scanned pages
IME_OCR_DPI=200
IME_OCR_CACHE=data/ocr_cache               # resume big files where they stopped
IME_DB_URL=sqlite:///data/ime_ledger.db
IME_INDEX_DIR=data/index                   # saved search index: a big file is indexed once
IME_CATALOG=on                             # read every page once: documents, providers, procedures, imaging, bills
IME_CATALOG_WORKERS=1                      # pages read at once; 2 is faster if Ollama allows it (OLLAMA_NUM_PARALLEL=2)
# IME_MODEL_EXTRACT=gemma4:26b-a4b         # model for the catalog; a smaller model is faster (test its accuracy first)
IME_API_KEY=                               # empty = no key needed (the web page only listens on this computer)

# ================================================================ LATER: AZURE (escalation + production)
